{
  "name": "ts-tutorial",
  "version": "1.0.0",
  "description": "npm init -y",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "build": "rimraf ./dist && npx tsc",
    "watch": "nodemon --watch 'src/**/*.ts' --ignore 'src/**/*.spec.ts' --exec ts-node src/server.ts",
    "dev": "npx ts-node-dev server.ts",
    "clean": "rm -rf dist",
    "lint": "eslint 'src/**/*.ts'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/joi": "^17.2.3",
    "@types/node": "^22.15.17",
    "@typescript-eslint/eslint-plugin": "^8.6.0",
    "@typescript-eslint/parser": "^8.6.0",
    "eslint": "^9.10.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "express": "^4.21.0",
    "joi": "^17.13.3",
    "mongoose": "^8.11.0"
  }
}
